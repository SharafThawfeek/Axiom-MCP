# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

APP_NAME=Axiom Debug
ENVIRONMENT=development

# Postgres, matching infrastructure/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://axiom:password@localhost:5434/axiom_debug

# Required for /analyze to work. Free, self-serve signup: https://console.groq.com/keys
GROQ_API_KEY=

ANALYSIS_MODEL=openai/gpt-oss-120b
VERIFIER_MODEL=openai/gpt-oss-20b
AGENT_MAX_ITERATIONS=8

# Optional — used only by the offline indexer's extraction pass. If unset,
# extraction falls back to Groq automatically (see indexer/extract.py); the
# served app never needs this. Free, self-serve: https://aistudio.google.com/apikey
GEMINI_API_KEY=
EXTRACTION_MODEL=gemini-3.5-flash-lite

# Required only for running the offline indexer (backend/indexer).
# Needs "public_repo" or "repo" scope: https://github.com/settings/tokens
GITHUB_TOKEN=

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

LOGFIRE_TOKEN=
